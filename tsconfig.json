{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "**/*"],
    "exclude": ["dist"],
    "compilerOptions": {
        "strictNullChecks": true,
        "target": "ESNext",
        "allowJs": true,
        "jsx": "preserve",
        "lib": ["DOM", "DOM.Iterable", "DOM.AsyncIterable", "ESNext"],
        "paths": {
            "@modules/*": ["src/modules/*"],
            "@pages/*": ["src/pages/*"],
            "@stores/*": ["src/stores/*"],
            "@styles/*": ["src/styles/*"]
        }
    }
}
