---
export type ProductVisual = "primary" | "secondary" | "tertiary" | "dark";

export interface ProductAction {
    label: string;
    href: string;
    /** Tonal (filled) is the primary action, text is the secondary action. */
    variant?: "tonal" | "text";
}

export interface Product {
    visual: ProductVisual;
    packageName: string;
    title: string;
    description: string;
    actions: Array<ProductAction>;
    /** Optional static cover under `public/`, e.g. "/covers/mdc.svg". Falls back to the tonal gradient when omitted. */
    coverSrc?: string;
    coverAlt?: string;
}

interface Props {
    id: string;
    title: string;
    description: string;
    products: Array<Product>;
}

const { id, title, description, products } = Astro.props;
const headingId = `${id}-title`;
---

<section class="tile-grid" id={id} aria-labelledby={headingId}>
    <div class="list-meta">
        <h2 class="list-title" id={headingId}>{title}</h2>
        <p class="list-desc">{description}</p>
    </div>
    <div class="card-grid">
        {
            products.map((product) => (
                <article class="product">
                    {product.coverSrc ? (
                        <img
                            class="product-cover"
                            src={product.coverSrc}
                            alt={product.coverAlt ?? `${product.title} cover`}
                            loading="lazy"
                        />
                    ) : (
                        <div
                            class:list={["product-visual", `visual-${product.visual}`]}
                        />
                    )}
                    <p class="product-package">{product.packageName}</p>
                    <h3 class="product-title">{product.title}</h3>
                    <p class="product-desc">{product.description}</p>
                    <div class="product-actions">
                        {product.actions.map((action) => (
                            <a
                                class:list={[
                                    action.variant === "text"
                                        ? "btn-text"
                                        : "btn-tonal",
                                ]}
                                target="_blank"
                                rel="noopener"
                                href={action.href}
                            >
                                {action.label}
                            </a>
                        ))}
                    </div>
                </article>
            ))
        }
    </div>
</section>

<style>
    @reference "../styles/tailwind.css";
    .tile-grid {
        display: block;
        margin: 48px auto 24px;
        box-sizing: border-box;
        scroll-margin-top: 16px;
    }

    .list-meta {
        margin-bottom: 16px;
        box-sizing: border-box;
    }

    .list-title {
        margin: 0 0 8px 0;
        font-size: 28px;
        line-height: 36px;
        font-weight: 700;
        color: var(--md-sys-color-on-surface);
    }

    .list-desc {
        margin: 0;
        font-size: 14px;
        line-height: 20px;
        color: var(--md-sys-color-on-surface-variant);
    }

    .card-grid {
        display: grid;
        grid-template-columns: 1fr;

        gap: 12px;

        @media (width >= 540px) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        @media (width >= 600px) {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        @media (width >= 840px) {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        @media (width >= 1200px) {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        @media (width >= 1600px) {
            grid-template-columns: repeat(5, minmax(0, 1fr));
        }
    }

    :root[dark] .product .product-cover {
        filter: hue-rotate(50deg) invert(1);
    }

    .product {
        display: flex;
        flex-direction: column;
        border-radius: var(--md-sys-shape-corner-value-large);
        background-color: var(--md-sys-color-surface-container-low);
        overflow: hidden;

        transition-property: border-radius;
        transition-duration: 200ms;

        &:focus-within,
        &:hover {
            border-radius: var(--md-sys-shape-corner-value-extra-large);
        }

        .product-cover {
            display: block;
            width: 100%;
            height: 140px;
            object-fit: cover;
            border-radius: 12px;
            margin-bottom: 16px;
            background-color: var(--md-sys-color-secondary-container);
            filter: hue-rotate(250deg);
        }

        .product-package {
            all: unset;
            @apply label-medium text-on-surface-variant;
            padding-inline: 16px;
            margin-block: 4px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .product-title {
            all: unset;
            @apply label-large text-on-surface font-bold;
            padding-inline: 16px;
        }

        .product-desc {
            @apply body-medium text-on-surface;
            padding-inline: 16px;
            margin-block: 8px 4px;
            text-wrap: pretty;
            flex-grow: 1;
            flex-shrink: 1;
            overflow: auto;
        }

        .product-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 12px;
        }
    }

    .btn-tonal,
    .btn-text {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 0 16px;
        border-radius: 20px;
        font-size: 14px;
        line-height: 20px;
        font-weight: 500;
        text-decoration: none;
        transition: background 160ms ease, filter 160ms ease;

        &:focus-visible {
            outline: 2px solid var(--md-sys-color-primary);
            outline-offset: 2px;
        }
    }

    .btn-tonal {
        color: var(--md-sys-color-on-secondary-container);
        background-color: var(--md-sys-color-secondary-container);

        &:hover {
            filter: brightness(0.96);
        }
    }

    .btn-text {
        color: var(--md-sys-color-primary);

        &:hover {
            background-color: color-mix(in srgb, var(--md-sys-color-primary) 8%, transparent);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .product {
            transition: none;
        }

        .product:hover {
            transform: none;
        }
    }
</style>
