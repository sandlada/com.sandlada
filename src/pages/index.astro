---
import BrandFooter from "@modules/BrandFooter.astro"
import BrandHeader from "@modules/BrandHeader.astro"
import Hero from "@modules/Hero.astro"
import RootHTML from "@modules/html-structure/RootHTML.astro"
import ProductGrid, { type Product } from "@modules/ProductGrid.astro"
import ScrollingBanner, { type Banner } from "@modules/ScrollingBanner.astro"
import { Consts } from "@sandlada/consts.js"

const siteUrl = "https://sandlada.com"
const pageTitle = "Sandlada – Material Design UI, TS Libraries & Themes"
const pageDescription = "Sandlada is an open-source team building Material Design 3 UI libraries, TypeScript utilities, a color engine, and VSCode, Zed and OpenCode themes."

interface SoftwareProduct {
    name: string
    description: string
    kind: "SoftwareSourceCode" | "SoftwareApplication"
    url: string
    license: string
    sameAs?: Array<string>
    programmingLanguage?: string
    operatingSystem?: string
}

const softwareProducts: Array<SoftwareProduct> = [
    { name: "MDC", description: "An open source component library that follows the Material Design 3 design specifications.", kind: "SoftwareSourceCode", url: Consts.Repo.MDC.GitHubLink, license: Consts.Repo.MDC.LicenseLink, sameAs: [Consts.Repo.MDC.NpmLink], programmingLanguage: "TypeScript" },
    { name: "Material Design CSS", description: "A CSS package for Material Design tokens: Color, Palette, Motion, Shape, Spacing, Typography and prebuilt themes.", kind: "SoftwareSourceCode", url: Consts.Repo.MaterialDesignCSS.GitHubLink, license: Consts.Repo.MaterialDesignCSS.LicenseLink, sameAs: [Consts.Repo.MaterialDesignCSS.NpmLink], programmingLanguage: "CSS" },
    { name: "MDK", description: "A JavaScript library based on Material Design 3, providing data such as color, shape, shadow level, etc.", kind: "SoftwareSourceCode", url: Consts.Repo.MDK.GitHubLink, license: Consts.Repo.MDK.LicenseLink, sameAs: [Consts.Repo.MDK.NpmLink], programmingLanguage: "JavaScript" },
    { name: "Result", description: "A TypeScript library implementing the Result pattern, type-safe and exception-free error handling.", kind: "SoftwareSourceCode", url: Consts.Repo.Result.GitHubLink, license: Consts.Repo.Result.LicenseLink, sameAs: [Consts.Repo.Result.NpmLink], programmingLanguage: "TypeScript" },
    { name: "Breakpoint", description: "Responsive viewport and element breakpoint observer, MD3 defaults, RxJS, zero-framework.", kind: "SoftwareSourceCode", url: Consts.Repo.Breakpoint.GitHubLink, license: Consts.Repo.Breakpoint.LicenseLink, sameAs: [Consts.Repo.Breakpoint.NpmLink], programmingLanguage: "TypeScript" },
    { name: "Document Context", description: "A function-first, DOM-anchored IoC container and reactive state management library for browsers.", kind: "SoftwareSourceCode", url: Consts.Repo.DocumentContext.GitHubLink, license: Consts.Repo.DocumentContext.LicenseLink, sameAs: [Consts.Repo.DocumentContext.NpmLink], programmingLanguage: "TypeScript" },
    { name: "MCU Helper", description: "High-performance functional engine for Material Design 3 color tokens, dynamic schemes and OLED dark themes.", kind: "SoftwareSourceCode", url: Consts.Repo.MCUHelper.GitHubLink, license: Consts.Repo.MCUHelper.LicenseLink, sameAs: [Consts.Repo.MCUHelper.NpmLink], programmingLanguage: "TypeScript" },
    { name: "Material Theme CLI", description: "Material Design CLI for generating theme tokens and serialized color outputs from a source color.", kind: "SoftwareSourceCode", url: Consts.Repo.MaterialThemeCLI.GitHubLink, license: Consts.Repo.MaterialThemeCLI.LicenseLink, sameAs: [Consts.Repo.MaterialThemeCLI.NpmLink], programmingLanguage: "TypeScript" },
    { name: "VSCode Material Theme", description: "Material Design 3 theme for VSCode.", kind: "SoftwareApplication", url: Consts.Repo.VSCodeMaterialTheme.GitHubLink, license: Consts.Repo.VSCodeMaterialTheme.LicenseLink, operatingSystem: "Windows, macOS, Linux" },
    { name: "OpenCode Material Theme", description: "Material Design 3 themes for the OpenCode TUI, 194 static JSON themes across 9 variants.", kind: "SoftwareApplication", url: Consts.Repo.OpenCodeMaterialTheme.GitHubLink, license: Consts.Repo.OpenCodeMaterialTheme.LicenseLink, sameAs: [Consts.Repo.OpenCodeMaterialTheme.NpmLink], operatingSystem: "macOS, Linux, Windows" },
    { name: "Zed Material Theme", description: "Material Design 3 themes for Zed, Light, Dark and OLED across 9 variants.", kind: "SoftwareApplication", url: Consts.Repo.ZedMaterialTheme.GitHubLink, license: Consts.Repo.ZedMaterialTheme.LicenseLink, sameAs: [Consts.Repo.ZedMaterialTheme.NpmLink], operatingSystem: "macOS, Linux, Windows" },
    { name: "Material VSCode Extensions", description: "VSCode snippets: Material Web Snippets and Material Design CSS Snippets.", kind: "SoftwareApplication", url: Consts.Repo.MaterialVSCodeExtensions.GitHubLink, license: Consts.Repo.MaterialVSCodeExtensions.LicenseLink, operatingSystem: "Windows, macOS, Linux" },
]

const toSoftwareSchema = (product: SoftwareProduct): Record<string, unknown> => {
    const schema: Record<string, unknown> = {
        "@type": product.kind,
        name: product.name,
        description: product.description,
        url: product.url,
        license: product.license,
    }

    if (product.sameAs) schema.sameAs = product.sameAs

    if (product.kind === "SoftwareSourceCode") {
        schema.codeRepository = product.url
        if (product.programmingLanguage) schema.programmingLanguage = product.programmingLanguage
    } else {
        schema.applicationCategory = "DeveloperApplication"
        schema.operatingSystem = product.operatingSystem ?? "Windows, macOS, Linux"
        schema.offers = { "@type": "Offer", price: "0", priceCurrency: "USD" }
    }

    return schema
}

const organizationId = `${siteUrl}/#organization`
const websiteId = `${siteUrl}/#website`

const structuredData: Record<string, unknown> = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "Organization",
            "@id": organizationId,
            name: "Sandlada",
            url: `${siteUrl}/`,
            logo: { "@type": "ImageObject", url: `${siteUrl}/apple-touch-icon.png`, width: 180, height: 180 },
            image: `${siteUrl}/sandlada-cover.png`,
            description: pageDescription,
            founder: { "@type": "Person", name: "Kai Orion", url: Consts.Member.KaiOrion.GitHubProfileLink },
            sameAs: [Consts.Social.Twitter.Link, Consts.Social.GitHub.Link, Consts.Social.Npm.Link],
        },
        {
            "@type": "WebSite",
            "@id": websiteId,
            name: "Sandlada",
            url: `${siteUrl}/`,
            inLanguage: "en",
            description: pageDescription,
            publisher: { "@id": organizationId },
        },
        {
            "@type": "WebPage",
            "@id": `${siteUrl}/#webpage`,
            url: `${siteUrl}/`,
            name: pageTitle,
            description: pageDescription,
            isPartOf: { "@id": websiteId },
            about: { "@id": organizationId },
            inLanguage: "en",
            primaryImageOfPage: { "@type": "ImageObject", url: `${siteUrl}/sandlada-cover.png`, width: 1280, height: 640 },
        },
        {
            "@type": "ItemList",
            name: "Sandlada open source projects",
            numberOfItems: softwareProducts.length,
            itemListElement: softwareProducts.map((product, index) => ({
                "@type": "ListItem",
                position: index + 1,
                item: toSoftwareSchema(product),
            })),
        },
    ],
}

