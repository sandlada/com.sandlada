---

<RootHTML title={pageTitle} description={pageDescription} structuredData={structuredData}>

    <div class="width-protection">
        <BrandHeader />
    </div>

    <main class="width-protection" id="main-content" tabindex="-1">
        <video
            id="bg-video"
            class="bg-video"
            loop
            muted
            autoplay
            playsinline
            preload="metadata"
            aria-hidden="true"
            tabindex="-1"
            disablepictureinpicture
        >
            <source src="/imgs/code.webm" type="video/webm" />
        </video>
        <script is:inline>
            const SCROLL_LIMIT = 500
            const OPACITY_LIMIT = 200
            const toOpacity = (value, max = SCROLL_LIMIT) => {
                return OPACITY_LIMIT - (value / max * 100)
            }

            document.addEventListener('DOMContentLoaded', () => {
                const video = document.querySelector('#bg-video')

                window.addEventListener('scroll', (e) => {
                    const position = (e.currentTarget).scrollY
                    video.style.opacity = `${Math.max(5, toOpacity(position))}%`
                }, { passive: true, })
            })
        </script>
        <style>
            .bg-video {
                position: fixed;
                inset: 0;
                z-index: -1;
                width: 100dvw;
                height: 100dvh;
                object-fit: cover;
                filter: hue-rotate(-85deg);
                transition-property: opacity;
                transition-duration: 200ms;
            }
            :root[dark] {
                .bg-video {
                    filter: invert(100%) hue-rotate(85deg);
                }
            }
        </style>

        <Hero></Hero>

        <ScrollingBanner banners={Banners} />

        <section class="statement width-container" aria-label="Introduction">
            <h2 class="statement-text"><span class="wordmark">Sandlada</span> is a general-purpose open-source team. It uses simple Material Design 3 tokens to generate photorealistic interfaces that can be explored in real time.</h2>
        </section>

        <nav class="section-tabs width-container" aria-label="Product categories">
            <a href="#ui-library">UI Library</a>
            <a href="#ts-js-library">TS / JS Library</a>
            <a href="#extensions">Extensions</a>
            <a href="#principles">Principles</a>
        </nav>

        <!-- UI Library -->
        <ProductGrid
            id="ui-library"
            title="Modelling the interface"
            description="Experience the component world from tokens to surface — or witness dynamic color up close."
            products={uiLibraryProducts}
        />

        <!-- TS/JS Library -->
        <ProductGrid
            id="ts-js-library"
            title="Simulating logic"
            description="Generate vibrant ecosystems, from error handling to reactive state."
            products={tsJsLibraryProducts}
        />

        <!-- Extensions -->
        <ProductGrid
            id="extensions"
            title="Producing themes and fiction"
            description="Conjure imaginary worlds, light and dark scenarios across editors."
            products={extensionProducts}
        />

        <section class="principles" id="principles" aria-labelledby="principles-title">
            <h2 class="section-title" id="principles-title">Principles</h2>
            <div class="principles-grid">
                <article>
                    <h3>Material-native</h3>
                    <p>Tokens first. Every library follows Material Design 3 specs for color, shape, motion and typography.</p>
                </article>
                <article>
                    <h3>Type-safe</h3>
                    <p>TypeScript by default, exception-free APIs and framework-agnostic cores that stay portable.</p>
                </article>
                <article>
                    <h3>Responsibility</h3>
                    <p>Open source from day one. MIT licensed, documented, and built to amplify developer creativity while limiting unintended impact.</p>
                </article>
            </div>
        </section>
    </main>

    <span class="divider" aria-hidden="true"></span>

    <div class="width-protection my-8">
        <BrandFooter />
    </div>

</RootHTML>

<style>

    .divider {
        display: flex;
        height: 1px;
        background: var(--md-sys-color-outline-variant);
    }

    .width-container {

    }

    .visually-hidden {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        padding: 0;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
        border: 0;
    }

    .genie-page {
        display: block;
        overflow: clip;
    }

    .btn-pill-filled,
    .btn-pill-outlined {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 24px;
        border-radius: 999px;
        font-size: 14px;
        line-height: 20px;
        font-weight: 500;
        letter-spacing: 0.1px;
        text-decoration: none;
        transition: background 160ms ease, transform 160ms ease, box-shadow 160ms ease;

        &:focus-visible {
            outline: 2px solid var(--md-sys-color-primary);
            outline-offset: 2px;
        }

        &:active {
            transform: scale(0.98);
        }
    }

    .btn-pill-filled {
        color: var(--md-sys-color-on-primary);
        background-color: var(--md-sys-color-primary);
        box-shadow: 0 8px 20px -10px color-mix(in srgb, var(--md-sys-color-primary) 64%, transparent);

        &:hover {
            filter: brightness(0.94);
        }
    }

    .btn-pill-outlined {
        color: var(--md-sys-color-on-surface);
        border: 1px solid var(--md-sys-color-outline-variant);
        background-color: var(--md-sys-color-surface);

        &:hover {
            background-color: var(--md-sys-color-surface-container-high);
            border-color: var(--md-sys-color-outline);
        }
    }

    .statement {
        text-align: center;
        padding: 60px 24px 26px 24px;
        box-sizing: border-box;

        @media (width >= 640px) {
            padding-top: 76px;
        }
    }

    .statement-text {
        margin: 0 auto;
        max-width: 720px;
        font-size: 28px;
        line-height: 1.28;
        font-weight: 500;
        letter-spacing: -0.5px;
        color: var(--md-sys-color-on-surface);
        text-wrap: balance;

        @media (width >= 640px) {
            font-size: 38px;
            line-height: 1.2;
        }
    }

    .section-tabs {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 8px;
        padding: 18px 12px 8px 12px;
        box-sizing: border-box;

        & > a {
            font-size: 14px;
            line-height: 20px;
            font-weight: 500;
            color: var(--md-sys-color-on-surface-variant);
            text-decoration: none;
            border: 1px solid var(--md-sys-color-outline-variant);
            border-radius: 999px;
            padding: 9px 18px;
            transition: background 160ms ease, color 160ms ease, border-color 160ms ease;

            &:hover {
                color: var(--md-sys-color-on-secondary-container);
                background-color: var(--md-sys-color-secondary-container);
                border-color: transparent;
            }

            &:focus-visible {
                outline: 2px solid var(--md-sys-color-primary);
                outline-offset: 2px;
            }
        }
    }

    .section-title {
        margin: 0 0 8px 0;
        font-size: 28px;
        line-height: 36px;
        font-weight: 700;
        color: var(--md-sys-color-on-surface);
    }

    .principles {
        box-sizing: border-box;
        margin-block: 96px;
    }

    .principles-grid {
        display: grid;
        gap: 20px 12px;
        margin-top: 22px;

        @media (width >= 640px) {
            grid-template-columns: repeat(3, 1fr);
        }

        & > article {
            border-top: 1px solid var(--md-sys-color-outline-variant);
            padding-top: 16px;

            & > h3 {
                margin: 0;
                font-size: 16px;
                line-height: 22px;
                font-weight: 700;
                letter-spacing: 0.1px;
                color: var(--md-sys-color-on-surface);
            }

            & > p {
                margin: 8px 0 0 0;
                font-size: 14px;
                line-height: 20px;
                color: var(--md-sys-color-on-surface-variant);
                text-wrap: pretty;
            }
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .btn-pill-filled,
        .btn-pill-outlined {
            transition: none;
        }
    }

</style>
