---
import BrandFooter from "@modules/brand-footer/BrandFooter.astro"
import BrandHeader from "@modules/brand-header/BrandHeader.astro"
import RootHTML from "@modules/html-structure/RootHTML.astro"
import { Consts } from "@sandlada/consts.js"
---

<RootHTML title="Sandlada - A team of one, one pure passion" description="Sandlada, which means sandbox, is a personal open source team founded by Kai-Orion, a front-end development enthusiast.">

    <div class="width-container">
        <BrandHeader />
    </div>

    <div class="hero" id="hero">
        <h1 class="title">Sandlada</h1>
        <span class="subtitle">The name Sandlada is inspired by a Swedish word SANDLÅDA.</span>
    </div>

    <!-- UI Library -->
    <section class="horizontal-list-wrapper">
        <div class="list-meta">
            <h2 class="list-title">UI Library</h2>
            <p class="list-desc">Component library, CSS library and design tokens.</p>
        </div>
        <div class="horizontal-list">
            <article class="product">
                <p class="product-package">{Consts.Repo.MDC.FormalName}</p>
                <h3 class="product-title">MDC</h3>
                <p class="product-desc">An open source component library that follows the Material Design 3 design specifications.</p>
                <div class="product-actions">
                    <md-filled-tonal-button target="_blank" href={Consts.Repo.MDC.GitHubLink}>GitHub</md-filled-tonal-button>
                    <md-text-button target="_blank" href={Consts.Repo.MDC.NpmLink}>NPM</md-text-button>
                </div>
            </article>
            <article class="product">
                <p class="product-package">{Consts.Repo.MaterialDesignCSS.FormalName}</p>
                <h3 class="product-title">Material Design CSS</h3>
                <p class="product-desc">A CSS package for Material Design tokens: Color, Palette, Motion, Shape, Spacing, Typography and prebuilt themes.</p>
                <div class="product-actions">
                    <md-filled-tonal-button target="_blank" href={Consts.Repo.MaterialDesignCSS.GitHubLink}>GitHub</md-filled-tonal-button>
                    <md-text-button target="_blank" href={Consts.Repo.MaterialDesignCSS.NpmLink}>NPM</md-text-button>
                </div>
            </article>
            <article class="product">
                <p class="product-package">{Consts.Repo.MDK.FormalName}</p>
                <h3 class="product-title">MDK</h3>
                <p class="product-desc">A JavaScript library based on Material Design 3, providing data such as color, shape, shadow level, etc.</p>
                <div class="product-actions">
                    <md-filled-tonal-button target="_blank" href={Consts.Repo.MDK.GitHubLink}>GitHub</md-filled-tonal-button>
                    <md-text-button target="_blank" href={Consts.Repo.MDK.NpmLink}>NPM</md-text-button>
                </div>
            </article>
        </div>
    </section>

    <!-- TS/JS Library -->
    <section class="horizontal-list-wrapper">
        <div class="list-meta">
            <h2 class="list-title">TS / JS Library</h2>
            <p class="list-desc">Framework-agnostic utilities written in TypeScript.</p>
        </div>
        <div class="horizontal-list">
            <article class="product">
                <p class="product-package">{Consts.Repo.Result.FormalName}</p>
                <h3 class="product-title">Result</h3>
                <p class="product-desc">A TypeScript library implementing the Result pattern, type-safe and exception-free error handling.</p>
                <div class="product-actions">
                    <md-filled-tonal-button target="_blank" href={Consts.Repo.Result.GitHubLink}>GitHub</md-filled-tonal-button>
                    <md-text-button target="_blank" href={Consts.Repo.Result.NpmLink}>NPM</md-text-button>
                </div>
            </article>
            <article class="product">
                <p class="product-package">{Consts.Repo.Breakpoint.FormalName}</p>
                <h3 class="product-title">Breakpoint</h3>
                <p class="product-desc">Responsive viewport and element breakpoint observer, MD3 defaults, RxJS, zero-framework.</p>
                <div class="product-actions">
                    <md-filled-tonal-button target="_blank" href={Consts.Repo.Breakpoint.GitHubLink}>GitHub</md-filled-tonal-button>
                    <md-text-button target="_blank" href={Consts.Repo.Breakpoint.NpmLink}>NPM</md-text-button>
                </div>
            </article>
            <article class="product">
                <p class="product-package">{Consts.Repo.DocumentContext.FormalName}</p>
                <h3 class="product-title">Document Context</h3>
                <p class="product-desc">A function-first, DOM-anchored IoC container and reactive state management library for browsers.</p>
                <div class="product-actions">
                    <md-filled-tonal-button target="_blank" href={Consts.Repo.DocumentContext.GitHubLink}>GitHub</md-filled-tonal-button>
                    <md-text-button target="_blank" href={Consts.Repo.DocumentContext.NpmLink}>NPM</md-text-button>
                </div>
            </article>
            <article class="product">
                <p class="product-package">{Consts.Repo.MCUHelper.FormalName}</p>
                <h3 class="product-title">MCU Helper</h3>
                <p class="product-desc">High-performance functional engine for Material Design 3 color tokens, dynamic schemes and OLED dark themes.</p>
                <div class="product-actions">
                    <md-filled-tonal-button target="_blank" href={Consts.Repo.MCUHelper.GitHubLink}>GitHub</md-filled-tonal-button>
                    <md-text-button target="_blank" href={Consts.Repo.MCUHelper.NpmLink}>NPM</md-text-button>
                </div>
            </article>
            <article class="product">
                <p class="product-package">{Consts.Repo.MaterialThemeCLI.FormalName}</p>
                <h3 class="product-title">Material Theme CLI</h3>
                <p class="product-desc">Material Design CLI for generating theme tokens and serialized color outputs from a source color.</p>
                <div class="product-actions">
                    <md-filled-tonal-button target="_blank" href={Consts.Repo.MaterialThemeCLI.GitHubLink}>GitHub</md-filled-tonal-button>
                    <md-text-button target="_blank" href={Consts.Repo.MaterialThemeCLI.NpmLink}>NPM</md-text-button>
                </div>
            </article>
        </div>
    </section>

    <!-- Extensions -->
    <section class="horizontal-list-wrapper">
        <div class="list-meta">
            <h2 class="list-title">Extensions</h2>
            <p class="list-desc">Themes and VSCode plugins only.</p>
        </div>
        <div class="horizontal-list">
            <article class="product">
                <p class="product-package">{Consts.Repo.VSCodeMaterialTheme.FormalName}</p>
                <h3 class="product-title">{Consts.Repo.VSCodeMaterialTheme.DisplayName}</h3>
                <p class="product-desc">Material Design 3 theme for VSCode.</p>
                <div class="product-actions">
                    <md-filled-tonal-button target="_blank" href={Consts.Repo.VSCodeMaterialTheme.GitHubLink}>GitHub</md-filled-tonal-button>
                </div>
            </article>
            <article class="product">
                <p class="product-package">{Consts.Repo.OpenCodeMaterialTheme.FormalName}</p>
                <h3 class="product-title">OpenCode Material Theme</h3>
                <p class="product-desc">Material Design 3 themes for the OpenCode TUI, 194 static JSON themes across 9 variants.</p>
                <div class="product-actions">
                    <md-filled-tonal-button target="_blank" href={Consts.Repo.OpenCodeMaterialTheme.GitHubLink}>GitHub</md-filled-tonal-button>
                    <md-text-button target="_blank" href={Consts.Repo.OpenCodeMaterialTheme.NpmLink}>NPM</md-text-button>
                </div>
            </article>
            <article class="product">
                <p class="product-package">{Consts.Repo.ZedMaterialTheme.FormalName}</p>
                <h3 class="product-title">Zed Material Theme</h3>
                <p class="product-desc">Material Design 3 themes for Zed, Light, Dark and OLED across 9 variants.</p>
                <div class="product-actions">
                    <md-filled-tonal-button target="_blank" href={Consts.Repo.ZedMaterialTheme.GitHubLink}>GitHub</md-filled-tonal-button>
                    <md-text-button target="_blank" href={Consts.Repo.ZedMaterialTheme.NpmLink}>NPM</md-text-button>
                </div>
            </article>
            <article class="product">
                <p class="product-package">{Consts.Repo.MaterialVSCodeExtensions.FormalName}</p>
                <h3 class="product-title">Material VSCode Extensions</h3>
                <p class="product-desc">VSCode snippets: Material Web Snippets and Material Design CSS Snippets.</p>
                <div class="product-actions">
                    <md-filled-tonal-button target="_blank" href={Consts.Repo.MaterialVSCodeExtensions.GitHubLink}>GitHub</md-filled-tonal-button>
                </div>
            </article>
        </div>
    </section>

    <span class="divider" aria-hidden="true"></span>

    <div class="width-container">
        <BrandFooter />
    </div>

</RootHTML>

<script>
    import "@material/web/button/filled-tonal-button.js"
    import "@material/web/button/text-button.js"
</script>

<style>

    .divider {
        display: flex;
        height: 1px;
        background: var(--md-sys-color-outline-variant);
    }

    .width-container {
        max-width: 840px;
        margin-left: auto;
        margin-right: auto;
    }

    .hero {
        position: relative;
        text-align: center;
        display: block;
        margin-left: auto;
        margin-right: auto;
        padding-top: 56px;
        margin-bottom: 96px;

        @media (width >= 640px) {
            padding-top: 64px;
            margin-bottom: 128px;
        }

        & > .title {
            font-size: 56px;
            @media (width >= 560px) {
                font-size: 72px;
            }
            @media (width >= 640px) {
                font-size: 96px;
            }
            font-weight: 900;
            color: var(--md-sys-color-primary);
        }
        & > .subtitle {
            font-size: 18px;
            font-weight: 500;
            color: var(--md-sys-color-primary);
        }
    }

    .horizontal-list-wrapper {
        position: relative;
        display: block;
        margin-bottom: 56px;
        padding: 12px;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-template-rows: auto 1fr;
        &::after {
            content: '';
            display: flex;
            position: absolute;
            width: 56px;
            bottom: 0;
            right: 0;
            height: 324px;
            z-index: 1;
            pointer-events: none;
            background: linear-gradient(to left, var(--md-sys-color-surface), transparent);
        }
    }

    .list-meta {
        grid-column: 1/-1;
        grid-row: 1/2;
        @media (width >= 840px) {
            grid-column: 2/-1;
        }

        margin-bottom: 16px;
        box-sizing: border-box;
    }

    .list-title {
        margin: 0 0 8px 0;
        font-size: 28px;
        line-height: 36px;
        font-weight: 700;
        color: var(--md-sys-color-on-surface);
    }

    .list-desc {
        margin: 0;
        font-size: 14px;
        line-height: 20px;
        color: var(--md-sys-color-on-surface-variant);
    }

    .horizontal-list {
        grid-row: 2/3;
        grid-column: 1/-1;
        @media (width >= 840px) {
            grid-column: 2/-1;
        }

        position: relative;
        z-index: 0;
        overflow-x: auto;
        overflow-y: hidden;
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 360px;
        grid-template-rows: 1fr;
        gap: 12px;
        min-height: 300px;
        width: 100%;
        padding-right: 56px;

        scrollbar-width: thin;
        scrollbar-color: var(--md-sys-color-primary) transparent;

        &::-webkit-scrollbar {
            height: 8px;
        }
        &::-webkit-scrollbar-track {
            background: transparent;
        }
        &::-webkit-scrollbar-thumb {
            background-color: var(--md-sys-color-primary);
            border-radius: 8px;
        }
        &::-webkit-scrollbar-thumb:hover {
            background-color: var(--md-sys-color-secondary);
        }
    }

    .product {
        display: flex;
        flex-direction: column;
        width: 100%;
        box-sizing: border-box;
        border-radius: 20px;
        border: 1px solid var(--md-sys-color-outline-variant);
        background-color: var(--md-sys-color-surface-container-low);
        padding: 24px;

        .product-package {
            margin: 0;
            font-size: 12px;
            line-height: 16px;
            font-weight: 500;
            letter-spacing: 0.4px;
            color: var(--md-sys-color-on-surface-variant);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .product-title {
            margin: 8px 0 0 0;
            font-size: 22px;
            line-height: 28px;
            font-weight: 700;
            color: var(--md-sys-color-on-surface);
        }

        .product-desc {
            margin: 12px 0 0 0;
            flex-grow: 1;
            font-size: 14px;
            line-height: 20px;
            color: var(--md-sys-color-on-surface-variant);
        }

        .product-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-top: 20px;
            opacity: 0;
        }
        &:focus-within .product-actions,
        &:hover .product-actions {
            opacity: 1;
        }
    }

</style>
