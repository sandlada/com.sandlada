    {
        title: 'Building interfaces',
        description: 'Generate vibrant UIs, from component behaviors to intricate design tokens.',
        href: '#ui-library',
        linkElementTextContent: 'Explore',
        image: '/imgs/stack.webp',

    },
    {
        title: 'Simulating logic',
        description: 'Type-safe utilities, from Result handling to reactive breakpoint observers.',
