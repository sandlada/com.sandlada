const extensionProducts: Array<Product> = [
    {
        visual: "tertiary",
        packageName: Consts.Repo.VSCodeMaterialTheme.FormalName,
        title: 'VSCode Material Theme',
        description: "Material Design 3 theme for VSCode.",
        coverSrc: "/covers/vscode-material-theme.webp",
        coverAlt: "Glowing frosted editor window for the VSCode Material theme",
        actions: [
            { label: "GitHub", href: Consts.Repo.VSCodeMaterialTheme.GitHubLink },
        ],
    },
    {
        visual: "dark",
        packageName: Consts.Repo.OpenCodeMaterialTheme.FormalName,
        title: "OpenCode Material Theme",
        description: "Material Design 3 themes for the OpenCode TUI, 194 static JSON themes across 9 variants.",
        coverSrc: "/covers/opencode-material-theme.webp",
        coverAlt: "Glowing terminal cell grid for the OpenCode Material theme",
        actions: [
            { label: "GitHub", href: Consts.Repo.OpenCodeMaterialTheme.GitHubLink },
            { label: "NPM", href: Consts.Repo.OpenCodeMaterialTheme.NpmLink, variant: "text" },
