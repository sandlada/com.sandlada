---
import BrandFooter from "@modules/BrandFooter.astro"
import BrandHeader from "@modules/BrandHeader.astro"
import RootHTML from "@modules/html-structure/RootHTML.astro"
import { Consts } from "@sandlada/consts.js"

/**
 * How long the automatic redirect waits before forwarding visitors to the homepage.
 * The redirect is cancelled as soon as the visitor shows any sign of interacting
 * with the page, so nobody gets yanked away while reading.
 */
const REDIRECT_DELAY_SECONDS = 10

const destinations: Array<{ label: string; href: string; external?: boolean }> = [
    { label: "Homepage", href: "/" },
    { label: "UI libraries", href: "/#ui-library" },
    { label: "TypeScript & JS tools", href: "/#ts-js-library" },
    { label: "Editor themes & extensions", href: "/#extensions" },
    { label: "Principles", href: "/#principles" },
    { label: "GitHub", href: Consts.Social.GitHub.Link, external: true },
]
---

<RootHTML
    title="404 – Page not found | Sandlada"
    description="The page you requested could not be found. Jump back into Sandlada's open-source Material Design 3 UI libraries, TypeScript tools and editor themes."
    robots="noindex, follow"
    url=""
>
    <div class="width-protection">
        <BrandHeader />
    </div>
    <main class="not-found width-protection" id="main-content" tabindex="-1">
        <p class="error-code wordmark" aria-hidden="true">404</p>
        <h1>Page not found</h1>
        <p class="lead">
            The page you requested does not exist or has moved. Check the address for typos,
            or continue to one of the destinations below.
        </p>

        <nav class="primary-actions" aria-label="Recovery actions">
            <a class="btn-tonal" href="/">Back to homepage</a>
            <a class="btn-text" href="/#ui-library">Explore libraries</a>
        </nav>

        <p class="redirect-status" role="status" aria-live="polite" data-redirect-status hidden>
            Redirecting to the homepage in
            <span data-redirect-seconds>{REDIRECT_DELAY_SECONDS}</span>
            seconds.
            <button type="button" class="stay-button" data-redirect-cancel>Stay on this page</button>
        </p>
    </main>

    <section class="destinations width-protection" aria-labelledby="destinations-title">
        <h2 id="destinations-title">Popular destinations</h2>
        <ul>
            {destinations.map((destination) => (
                <li>
                    <a
                        href={destination.href}
                        target={destination.external ? "_blank" : undefined}
                        rel={destination.external ? "noopener" : undefined}
                    >
                        {destination.label}
                    </a>
                </li>
            ))}
        </ul>
    </section>

    <div class="width-protection my-8">
        <BrandFooter />
    </div></RootHTML>

<script>
    const REDIRECT_DELAY_MS = 10_000
    const REDIRECT_TARGET = "/"
    const USER_INTENT_EVENTS = ["pointerdown", "keydown", "wheel", "touchstart"] as const

    let redirectTimer: ReturnType<typeof setTimeout> | undefined
    let countdownTimer: ReturnType<typeof setInterval> | undefined

    const removeUserIntentListeners = () => {
        for (const eventName of USER_INTENT_EVENTS) {
            window.removeEventListener(eventName, onUserIntent)
        }
    }

    const stopRedirect = () => {
        removeUserIntentListeners()
        if (redirectTimer !== undefined) {
            clearTimeout(redirectTimer)
            redirectTimer = undefined
        }
        if (countdownTimer !== undefined) {
            clearInterval(countdownTimer)
            countdownTimer = undefined
        }
    }

    const onUserIntent = () => {
        stopRedirect()
        const status = document.querySelector<HTMLElement>("[data-redirect-status]")
        if (status) {
            status.textContent = "Automatic redirect cancelled. Pick a destination below to keep exploring."
        }
    }

    const addUserIntentListeners = () => {
        for (const eventName of USER_INTENT_EVENTS) {
            window.addEventListener(eventName, onUserIntent, { passive: true })
        }
    }

    const startRedirect = () => {
        stopRedirect()

        const status = document.querySelector<HTMLElement>("[data-redirect-status]")
        const seconds = document.querySelector<HTMLElement>("[data-redirect-seconds]")
        if (!status) return

        // Only reveal the countdown once JavaScript is alive to run it.
        status.hidden = false

        let remaining = Math.ceil(REDIRECT_DELAY_MS / 1000)
        const renderRemaining = () => {
            if (seconds) seconds.textContent = String(Math.max(remaining, 0))
        }

        renderRemaining()
        addUserIntentListeners()

        countdownTimer = setInterval(() => {
            remaining -= 1
            renderRemaining()
            if (remaining <= 0 && countdownTimer !== undefined) {
                clearInterval(countdownTimer)
                countdownTimer = undefined
            }
        }, 1000)

        redirectTimer = setTimeout(() => {
            stopRedirect()
            window.location.replace(REDIRECT_TARGET)
        }, REDIRECT_DELAY_MS)
    }

    if (!document.documentElement.hasAttribute("data-404-redirect-bound")) {
        document.documentElement.setAttribute("data-404-redirect-bound", "")
        document.addEventListener("astro:before-swap", stopRedirect)
        document.addEventListener("astro:page-load", startRedirect)
    }
</script>

<style>
    .not-found {
        margin: 64px auto 0;
        text-align: center;
    }
    .error-code {
        margin: 0;
        font-size: 96px;
        line-height: 1;
        color: var(--md-sys-color-primary);
    }
    .not-found > h1 {
        margin-top: 8px;
        font-size: 40px;
        line-height: 48px;
        color: var(--md-sys-color-on-surface);
    }
    .lead {
        max-width: 560px;
        margin: 12px auto 0;
        color: var(--md-sys-color-on-surface-variant);
        text-wrap: pretty;
    }
    .primary-actions {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 24px;
    }
    .redirect-status {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 20px;
        font-size: 14px;
        color: var(--md-sys-color-on-surface-variant);
    }
    .stay-button {
        all: unset;
        cursor: pointer;
        color: var(--md-sys-color-primary);
        font-weight: 500;
        text-decoration: underline;
        border-radius: 4px;
    }
    .stay-button:focus-visible {
        outline: 2px solid var(--md-sys-color-primary);
        outline-offset: 2px;
    }

    .destinations {
        max-width: 840px;
        margin: 56px auto 96px;
        padding: 0 24px;
        text-align: center;
    }
    .destinations > h2 {
        font-size: 20px;
        line-height: 28px;
        font-weight: 700;
        color: var(--md-sys-color-on-surface);
    }
    .destinations > ul {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 16px;
    }
    .destinations > ul > li > a {
        display: inline-flex;
        align-items: center;
        min-height: 40px;
        padding: 0 18px;
        font-size: 14px;
        line-height: 20px;
        font-weight: 500;
        color: var(--md-sys-color-on-surface-variant);
        text-decoration: none;
        border: 1px solid var(--md-sys-color-outline-variant);
        border-radius: 999px;
        transition: background 160ms ease, color 160ms ease, border-color 160ms ease;
    }
    .destinations > ul > li > a:hover {
        color: var(--md-sys-color-on-secondary-container);
        background-color: var(--md-sys-color-secondary-container);
        border-color: transparent;
    }
    .destinations > ul > li > a:focus-visible {
        outline: 2px solid var(--md-sys-color-primary);
        outline-offset: 2px;
    }

    .btn-tonal,
    .btn-text {
        display: inline-flex;
        align-items: center;
        min-height: 40px;
        padding: 0 16px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
    }
    .btn-tonal {
        color: var(--md-sys-color-on-secondary-container);
        background-color: var(--md-sys-color-secondary-container);
    }
    .btn-text {
        color: var(--md-sys-color-primary);
    }
    .btn-tonal:focus-visible,
    .btn-text:focus-visible {
        outline: 2px solid var(--md-sys-color-primary);
        outline-offset: 2px;
    }

    @media (prefers-reduced-motion: reduce) {
        .destinations > ul > li > a {
            transition: none;
        }
    }
</style>
