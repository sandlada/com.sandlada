---
import BrandFooter from "@modules/brand-footer/BrandFooter.astro"
import BrandHeader from "@modules/BrandHeader.astro"
import RootHTML from "@modules/html-structure/RootHTML.astro"
---

<RootHTML
    title="Page not found – Sandlada"
    description="The page you requested does not exist. Return to Sandlada to explore open-source Material Design UI libraries and TypeScript tools."
    robots="noindex, follow"
>
    <div class="width-container">
        <BrandHeader />
    </div>

    <main class="not-found">
        <h1>Page not found</h1>
        <p>The page you visited does not exist or has moved.</p>
        <nav aria-label="Not found navigation">
            <a class="btn-tonal" href="/">Back to homepage</a>
        </nav>
    </main>

    <div class="width-container">
        <BrandFooter />
    </div>
</RootHTML>

<style>
    .width-container {
        max-width: 840px;
        margin-left: auto;
        margin-right: auto;
    }
    .not-found {
        max-width: 840px;
        margin: 64px auto 96px;
        padding: 0 12px;
        text-align: center;
        & > h1 {
            font-size: 40px;
            line-height: 48px;
            color: var(--md-sys-color-on-surface);
        }
        & > p {
            margin-top: 12px;
            color: var(--md-sys-color-on-surface-variant);
        }
        & > nav {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 24px;
        }
    }
    .btn-tonal,
    .btn-text {
        display: inline-flex;
        align-items: center;
        min-height: 40px;
        padding: 0 16px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 500;
        text-decoration: none;
    }
    .btn-tonal {
        color: var(--md-sys-color-on-secondary-container);
        background-color: var(--md-sys-color-secondary-container);
    }
    .btn-text {
        color: var(--md-sys-color-primary);
    }
</style>
